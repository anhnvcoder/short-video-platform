{
  "name": "svp-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit",
    "e2e": "playwright test",
    "generate": "openapi-typescript ../services/gateway/openapi.yaml --output gen/api.d.ts",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@sentry/nextjs": "11.8.0",
    "@tanstack/react-query": "5.104.4",
    "hls.js": "1.7.3",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redis": "6.3.0",
    "server-only": "0.0.1",
    "web-vitals": "6.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "sentry": "0.45.0",
    "size-limit": "14.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
