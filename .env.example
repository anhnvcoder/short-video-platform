# Local secrets for `make up` (deploy/compose/compose.yaml). Do not fill this file in: run
# `make env`, which writes .env (git-ignored, mode 600) with random passwords and a new JWT key.

# Postgres role passwords, applied by `make db-bootstrap` (deploy/postgres/bootstrap.sh).
SVP_USER_MIGRATOR_DB_PASSWORD=
SVP_USER_APP_DB_PASSWORD=
SVP_VIDEO_MIGRATOR_DB_PASSWORD=
SVP_VIDEO_APP_DB_PASSWORD=
SVP_ENGAGEMENT_MIGRATOR_DB_PASSWORD=
SVP_ENGAGEMENT_APP_DB_PASSWORD=
SVP_FEED_MIGRATOR_DB_PASSWORD=
SVP_FEED_APP_DB_PASSWORD=
SVP_GLITCHTIP_MIGRATOR_DB_PASSWORD=
SVP_GLITCHTIP_APP_DB_PASSWORD=

# MinIO root password (only the minio and minio-init containers get it) and the secret keys of
# the per-service MinIO users svp-video-service and svp-media-worker (deploy/minio/init.sh).
SVP_MINIO_ROOT_PASSWORD=
SVP_VIDEO_S3_SECRET_KEY=
SVP_MEDIA_WORKER_S3_SECRET_KEY=

# GlitchTip error tracker (obs profile): Django secret key, and the login of its admin user at
# http://127.0.0.1:8000 (a fixed local address, admin@svp.local, and a random password).
GLITCHTIP_SECRET_KEY=
GLITCHTIP_ADMIN_EMAIL=
GLITCHTIP_ADMIN_PASSWORD=

# Ed25519 JWT key pair from tools/jwtkey. The signing key goes to user-service only; the gateway
# gets the public keys only.
JWT_SIGNING_KID=
JWT_SIGNING_KEY=
JWT_VERIFY_KEYS=

# Filled in by you, not by `make env`; empty is fine.
# Telegram bot token and chat id for paging alerts from Alertmanager (obs profile). With either
# one empty, alerts are only shown in the Alertmanager UI.
SVP_ALERT_TELEGRAM_BOT_TOKEN=
SVP_ALERT_TELEGRAM_CHAT_ID=
# Environment tag on the error events the services send to the tracker at SENTRY_DSN; empty
# means local.
SENTRY_ENVIRONMENT=

# Written by `make glitchtip-init` (and `make up OBS=lgtm`), not by `make env`, once GlitchTip is
# initialized; a value already set is kept. SENTRY_DSN is the DSN the services send errors to
# (empty: off); the other four are for scripts on the host that read events through GlitchTip's
# API with the read-only token.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_API_URL=
