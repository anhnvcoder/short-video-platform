# Template of the k6 Job of the cloud cluster, filled in by render.sh:
# @K6_IMAGE@ (K6_IMAGE of the Makefile), @DOMAIN@, @WEB_ORIGIN@, @ENVOY_IP@, @FORWARDED_FOR@, @SCRIPT_ITEMS@, @PODS@,
# @DEADLINE@, @CPU_REQUEST@, @CPU_LIMIT@, @RAMP@ and @HOLD@. Not a manifest on its own (hence .yaml.in, which make cloud-check does
# not read; it checks the output of render.sh).
#
# Namespace svp-load is outside svp, so Kyverno's image policy does not apply, and runs under PSA restricted. 20 pods of
# one Indexed Job, each running its own execution segment of profile cloud: k6 splits the rates, and each pod registers
# its own pool from its own pod IP (no rate limit key is ever deleted on the cloud). 20 is `pods` of profile cloud in
# lib/config.js, which sizes VUs and pools per pod; setup() refuses a run with another number of segments. Fewer pods
# (render.sh --pods) keep the lines marked @PODS@: SVP_K6_PODS tells the scripts the count, and the rates shrink with
# it, each pod keeping the load of one pod of the design. The lines marked @RAMP@ and @HOLD@ stay only with
# render.sh --ramp and --hold, @CPU_LIMIT@ only with --cpu-limit. The pods
# call Envoy's Service inside the cluster: hostAliases point the public names at its ClusterIP, so TLS checks the real
# certificate while the load never crosses the public load balancer or the internet.
#
# The lines marked @CA@ stay only with render.sh --ca-file, for an Envoy whose certificate a private CA signs (a cluster
# CA behind a load balancer that holds the public certificate): they mount ConfigMap svp-k6-ca and point SSL_CERT_FILE
# at it. k6 has no flag for a CA; Go's crypto/x509, which k6 uses on Linux, reads that file in place of the image's
# bundle file, but still reads every certificate file in /etc/ssl/certs and /etc/pki/tls/certs (only SSL_CERT_DIR
# would replace those directories). So the private CA is trusted in addition to whatever roots the image holds in
# those directories, not instead of them. TLS is still checked, never skipped.
apiVersion: v1
kind: Namespace
metadata:
  name: svp-load
  labels:
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/warn: restricted
---
apiVersion: batch/v1
kind: Job
metadata:
  name: svp-k6
  namespace: svp-load
spec:
  completionMode: Indexed
  completions: @PODS@
  parallelism: @PODS@
  # A pod run again would register its pool again: a failed pod is a result to read, not to retry. The limit is per
  # index so that one pod failing (k6 exits 99 on a threshold it missed) does not end the Job, which would make the
  # Job controller delete the pods still running before they print their summary; the Job ends, Failed if any index
  # failed, once every index has finished.
  backoffLimitPerIndex: 0
  # The whole run with room, so that a stuck run ends here: by default 3600 s for the profile's 10 min ramp, 10 min
  # hold and 1 min down; with render.sh --ramp or --hold, ramp + hold + 1 min down + 15 min for the pods to be pulled
  # and scheduled, setup() (3 min at most) and the summary.
  activeDeadlineSeconds: @DEADLINE@
  template:
    metadata:
      labels:
        app.kubernetes.io/name: svp-k6
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        # The k6 user of the image.
        runAsUser: 12345
        runAsGroup: 12345
        seccompProfile:
          type: RuntimeDefault
      hostAliases:
        - ip: "@ENVOY_IP@"
          hostnames: ["api.@DOMAIN@", "@DOMAIN@"]
      containers:
        - name: k6
          image: "@K6_IMAGE@"
          command: ["sh", "-c"]
          # Pod i of N runs segment i/N:(i+1)/N of an even sequence. $$ keeps Kubernetes from reading $(( )) as a
          # reference to a variable.
          args:
            - |
              i=$JOB_COMPLETION_INDEX
              seq=0; n=1
              while [ "$n" -lt @PODS@ ]; do seq="$seq,$n/@PODS@"; n=$$((n + 1)); done
              exec k6 run --quiet --include-system-env-vars \
                --execution-segment "$i/@PODS@:$$((i + 1))/@PODS@" --execution-segment-sequence "$seq,1" /scripts/main.js
          env:
            - name: SVP_K6_PROFILE
              value: cloud
            - name: SVP_API_URL
              value: "https://api.@DOMAIN@"
            - name: SVP_WEB_URL
              value: "https://@DOMAIN@"
            - name: SVP_WEB_ORIGIN
              value: "@WEB_ORIGIN@"
            - name: SVP_K6_PODS # @PODS@
              value: "@PODS@" # @PODS@
            - name: SVP_K6_RAMP # @RAMP@
              value: "@RAMP@" # @RAMP@
            - name: SVP_K6_HOLD # @HOLD@
              value: "@HOLD@" # @HOLD@
            - name: SVP_K6_POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            # Empty, or this pod's IP when stage 7 trusts two hops (render.sh --forwarded-for; threat model RL-7).
            - name: SVP_K6_FORWARDED_FOR
              value: "@FORWARDED_FOR@"
            - name: K6_NO_USAGE_REPORT
              value: "true"
            - name: K6_AUTO_EXTENSION_RESOLUTION
              value: "false"
            - name: SSL_CERT_FILE # @CA@
              value: /etc/svp-k6-ca/ca.crt # @CA@
          resources:
            requests:
              cpu: "@CPU_REQUEST@"
              memory: 256Mi
            limits:
              cpu: "@CPU_LIMIT@" # @CPU_LIMIT@
              memory: 1Gi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: scripts
              mountPath: /scripts
              readOnly: true
            - name: ca # @CA@
              mountPath: /etc/svp-k6-ca # @CA@
              readOnly: true # @CA@
      volumes:
        - name: scripts
          configMap:
            name: svp-k6-scripts
            items: @SCRIPT_ITEMS@
        - name: ca # @CA@
          configMap: # @CA@
            name: svp-k6-ca # @CA@
