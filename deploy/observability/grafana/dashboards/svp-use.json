    {
      "type": "timeseries",
      "title": "Data refused or failed (dropped)",
      "description": "Per Collector (otelcol: the obs Collector the services send to; otelcol-contrib: the one inside lgtm). Receiver side: data refused (back-pressure, e.g. the memory limiter) or failed on the way in. Exporter side: enqueue failed (sending queue full, data dropped) and send failed (backend rejected the data or was unreachable).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_name, receiver) (rate(otelcol_receiver_refused_spans_total{service_name=~\"otelcol|otelcol-contrib\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{receiver}} spans refused",
          "range": true,
          "instant": false,
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (service_name, receiver) (rate(otelcol_receiver_refused_metric_points_total{service_name=~\"otelcol|otelcol-contrib\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{receiver}} points refused",
          "range": true,
          "instant": false,
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
