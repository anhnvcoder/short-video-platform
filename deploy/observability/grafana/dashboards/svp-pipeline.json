      "title": "Service graph",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Built by Tempo from spans (traces_service_graph_*); host.docker.internal is the native Postgres.",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "serviceMap"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
