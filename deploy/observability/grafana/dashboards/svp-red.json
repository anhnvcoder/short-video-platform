{
  "uid": "svp-red",
  "title": "SVP — RED (HTTP, gRPC)",
  "description": "Rate, errors and duration of the gateway's HTTP routes and the gRPC services (ADR-0011 §5).",
  "tags": [
    "svp"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "service",
        "label": "gRPC service",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(rpc_server_call_duration_seconds_count, service_name)",
        "definition": "label_values(rpc_server_call_duration_seconds_count, service_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "regex": "",
        "hide": 0,
        "options": [],
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "type": "query",
        "name": "route",
        "label": "HTTP route",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_request_duration_seconds_count{service_name=\"gateway\"}, http_route)",
        "definition": "label_values(http_server_request_duration_seconds_count{service_name=\"gateway\"}, http_route)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "regex": "",
        "hide": 0,
        "options": [],
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "svp"
      ],
      "asDropdown": true,
      "title": "SVP dashboards",
      "includeVars": false,
      "keepTime": true
