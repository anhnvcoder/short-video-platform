.DS_Store

.env
.env.*
!.env.example

# Go build/test output
/bin/
*.test
*.out

.terraform/
*.tfstate
*.tfstate.*

# Local Kubernetes output: the cluster CA exported for curl, Helm cache and config of the k8s scripts
.k8s/

# CI's clone of the deployment configuration svp-gitops (make gitops-clone)
.gitops/

# CI's clone of the web client's source svp-web (make web-clone)
.web/

# Load test results of make load-local / make load-ci (deploy/k6/load.sh)
.k6/

# DAST reports of make dast (deploy/dast/run.sh); the log, JUnit and HAR hold response bodies with test tokens
.dast/

# Web client: packages, Next build output, test reports; next-env.d.ts and the TypeScript build info are regenerated by
# next typegen/next build (Next's own template ignores them)
web/node_modules/
web/.next/
web/test-results/
web/playwright-report/
web/coverage/
web/next-env.d.ts
web/*.tsbuildinfo
